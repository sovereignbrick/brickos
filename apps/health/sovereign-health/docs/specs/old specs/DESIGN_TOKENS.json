{
  "design_system": {
    "name": "Health Tracker MVP",
    "version": "1.0.0",
    "colors": {
      "semantic": {
        "success": "#10B981",
        "warning": "#F59E0B",
        "critical": "#EF4444",
        "brand": "#8B5CF6",
        "neutral": {
          "white": "#FFFFFF",
          "light_gray": "#F4F4F6",
          "medium_gray": "#9CA3AF",
          "dark_gray": "#374151",
          "text_primary": "#1F2937"
        }
      },
      "status": {
        "in_range": "#10B981",
        "warning": "#F59E0B",
        "critical": "#EF4444",
        "neutral": "#9CA3AF"
      },
      "backgrounds": {
        "screen": "#F4F4F6",
        "card": "#FFFFFF",
        "success_light": "#ECFDF5",
        "warning_light": "#FFFBEB",
        "critical_light": "#FEF2F2"
      }
    },
    "typography": {
      "font_family": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "scales": {
        "h1": {
          "size": "32px",
          "weight": "700",
          "line_height": "1.2",
          "letter_spacing": "-0.5px",
          "usage": "Page title, main headings"
        },
        "h2": {
          "size": "20px",
          "weight": "600",
          "line_height": "1.3",
          "letter_spacing": "0px",
          "usage": "Section titles"
        },
        "h3": {
          "size": "18px",
          "weight": "600",
          "line_height": "1.4",
          "letter_spacing": "0px",
          "usage": "Card titles"
        },
        "body": {
          "size": "16px",
          "weight": "400",
          "line_height": "1.5",
          "letter_spacing": "0px",
          "usage": "Main content"
        },
        "body_small": {
          "size": "14px",
          "weight": "400",
          "line_height": "1.5",
          "letter_spacing": "0px",
          "usage": "Secondary content"
        },
        "caption": {
          "size": "12px",
          "weight": "400",
          "line_height": "1.5",
          "letter_spacing": "0px",
          "color": "#9CA3AF",
          "usage": "Metadata, timestamps"
        },
        "metric_value": {
          "size": "28px",
          "weight": "600",
          "line_height": "1.2",
          "letter_spacing": "-0.5px",
          "usage": "Measurement values"
        },
        "metric_unit": {
          "size": "14px",
          "weight": "400",
          "line_height": "1.4",
          "color": "#6B7280",
          "usage": "Units next to values"
        }
      }
    },
    "spacing": {
      "base": "4px",
      "scale": {
        "xs": "4px",
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "32px",
        "4xl": "40px"
      },
      "screen_padding": "20px",
      "card_padding": "16px",
      "grid_gap": "12px",
      "section_spacing": "24px"
    },
    "border_radius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "2xl": "20px",
      "full": "9999px"
    },
    "shadows": {
      "none": "none",
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1)"
    },
    "components": {
      "button": {
        "primary": {
          "bg": "#8B5CF6",
          "text": "#FFFFFF",
          "padding": "12px 20px",
          "border_radius": "8px",
          "font_size": "16px",
          "font_weight": "600"
        },
        "secondary": {
          "bg": "#F4F4F6",
          "text": "#1F2937",
          "padding": "12px 20px",
          "border_radius": "8px",
          "border": "1px solid #E5E7EB"
        },
        "danger": {
          "bg": "#EF4444",
          "text": "#FFFFFF",
          "padding": "12px 20px",
          "border_radius": "8px"
        }
      },
      "card": {
        "background": "#FFFFFF",
        "border_radius": "16px",
        "padding": "16px",
        "shadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "border": "1px solid #F3F4F6"
      },
      "input": {
        "padding": "12px 16px",
        "border_radius": "8px",
        "border": "1px solid #E5E7EB",
        "font_size": "16px",
        "focus_ring": "2px solid #8B5CF6"
      },
      "badge": {
        "success": {
          "bg": "#ECFDF5",
          "text": "#10B981",
          "padding": "4px 8px",
          "border_radius": "4px",
          "font_size": "12px"
        },
        "warning": {
          "bg": "#FFFBEB",
          "text": "#F59E0B",
          "padding": "4px 8px",
          "border_radius": "4px",
          "font_size": "12px"
        },
        "critical": {
          "bg": "#FEF2F2",
          "text": "#EF4444",
          "padding": "4px 8px",
          "border_radius": "4px",
          "font_size": "12px"
        }
      }
    },
    "breakpoints": {
      "mobile": "0px",
      "tablet": "768px",
      "desktop": "1024px",
      "wide": "1280px"
    }
  }
}
