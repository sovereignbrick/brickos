# =============================================================================
#  Sovereign Health -- self-hosted configuration
#  AGPL-3.0 -- https://github.com/sovereignbrick/brickos
#
#  Copy to ".env" and adjust. This file is the source of truth for every
#  environment variable Sovereign Health reads. Variables are grouped:
#
#    [REQUIRED]    -- the app refuses to start without these
#    [CORE]        -- sensible defaults for self-host; override to customize
#    [OPTIONAL]    -- cloud features; leave blank for pure-local operation
#    [ADVANCED]    -- tuning knobs for scale/ops
#
#  Quick start (one-shot):
#    ./sh-install.sh   # generates /etc/sovereign-health/.env with random
#                      # secrets + sane defaults, pulls images, starts stack.
#
#  Docs: ../SELFHOSTED.md
# =============================================================================

# -----------------------------------------------------------------------------
# [REQUIRED] -- generate random values with: openssl rand -base64 32
# -----------------------------------------------------------------------------

# Database password for the bundled Postgres.
DB_PASSWORD=CHANGE_ME

# JWT signing secret. Rotating this invalidates all active sessions.
JWT_SECRET=CHANGE_ME

# AES-256 encryption key for sensitive measurement data at rest.
# 32 raw bytes, base64-encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# [CORE] -- default OSS-mode behavior for self-hosted.
# -----------------------------------------------------------------------------

# Deployment mode. "oss" (default for self-host) bypasses email verification,
# Stripe billing checks, and Mailgun send attempts. "production" is the
# managed-cloud mode; "dev" enables developer conveniences.
SHI_MODE=oss

# Database URL. The bundled compose uses this exact value.
DATABASE_URL=postgres://sovereign_health:${DB_PASSWORD}@db:5432/sovereign_health

# Frontend URL (used for email links and CORS allow-list). Leave as
# localhost for self-host; change if you put nginx in front on a custom
# domain.
FRONTEND_URL=http://localhost:3000

# Allow self-signup (required for the first admin user in a fresh install).
# Auto-enabled in oss mode.
REGISTRATION_ENABLED=true

# Log verbosity: error, warn, info, debug, trace
RUST_LOG=info

# -----------------------------------------------------------------------------
# [OPTIONAL] AI provider -- Dr. Alex chat.
# -----------------------------------------------------------------------------

# Options: anthropic | ollama | none
# - anthropic: uses ANTHROPIC_API_KEY below against api.anthropic.com
# - ollama:    uses OLLAMA_URL below against a local or remote Ollama server
# - none:      disables Dr. Alex entirely; UI shows "AI not configured"
AI_PROVIDER=none

# Anthropic API key (only read when AI_PROVIDER=anthropic).
# Get one at https://console.anthropic.com/ -- free tier available.
ANTHROPIC_API_KEY=

# Ollama endpoint (only read when AI_PROVIDER=ollama).
# Default matches the docker-compose.selfhosted-ai.yml bundle.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# [OPTIONAL] Email (Mailgun) -- only needed if you WANT the app to send
# verification, password-reset, or invite emails. Leave blank in oss mode;
# signup will auto-verify, password reset will be disabled, invites won't
# send.
# -----------------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net/v3

# -----------------------------------------------------------------------------
# [OPTIONAL] Billing (Stripe) -- tier upgrades / downgrades. Leave blank in
# oss mode; all users get unlimited/"core" tier automatically.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Strike (Bitcoin Lightning payments) -- same rules as Stripe above.
STRIKE_API_KEY=

# -----------------------------------------------------------------------------
# [OPTIONAL] Platform integrations -- only relevant for multi-tenant setups.
# Ignore for single-user self-host.
# -----------------------------------------------------------------------------
SHI_PLATFORM_DATABASE_URL=
SLI_API_URL=
SLI_API_KEY=
LICENSE_SIGNING_KEY_PATH=

# -----------------------------------------------------------------------------
# [OPTIONAL] Push notifications (VAPID for Web Push). Leave blank to
# disable PWA push notifications.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# [OPTIONAL] Observability.
# -----------------------------------------------------------------------------
SENTRY_DSN=
DEPLOY_ENVIRONMENT=selfhosted

# -----------------------------------------------------------------------------
# [ADVANCED] Rate limits + tuning.
# -----------------------------------------------------------------------------
AUTH_GOVERNOR_PER_SECOND=12
AUTH_GOVERNOR_BURST_SIZE=5
DEMO_GOVERNOR_SECONDS_PER_REQUEST=1
DEMO_GOVERNOR_BURST_SIZE=60
JWT_EXPIRY_SECS=7200
REFRESH_EXPIRY_SECS=5184000
SHI_PLATFORM_DB_POOL_MAX=10

# Public chat (landing-page AI widget; only relevant on marketing).
PUBLIC_CHAT_MODEL=claude-haiku-3-5-20241022
PUBLIC_CHAT_RATE_PER_HOUR=20
PUBLIC_CHAT_CONVERSATIONS_PER_HOUR=3
PUBLIC_CHAT_MAX_MESSAGES=8
PUBLIC_CHAT_MAX_TOKENS=4096
PUBLIC_CHAT_DAILY_TOKEN_LIMIT=500000
PUBLIC_CHAT_SESSION_TTL=3600

# Anthropic endpoint overrides (mostly for testing -- don't change in prod).
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

# CORS. Self-host same-origin = leave blank. Set a comma-separated list if
# you front this with a proxy on a different origin.
CORS_ORIGINS=

# Feature flags.
MARKER_ACCESS_USE_NEW_PATH=
MARKER_ACCESS_SHADOW_MODE=
