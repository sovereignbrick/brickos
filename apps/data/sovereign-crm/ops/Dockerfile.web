# Stage 1: Deps
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
COPY apps/data/sovereign-crm/frontend/package.json apps/data/sovereign-crm/frontend/pnpm-lock.yaml ./
COPY packages/ui /packages/ui
RUN sed -i 's|"workspace:\\*"|"file:/packages/ui"|g' package.json
RUN echo 'node-linker=hoisted' >> .npmrc && pnpm install --no-frozen-lockfile

# Stage 2: Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/data/sovereign-crm/frontend/ .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_NAME="Sovereign CRM"
RUN npm run build

# Stage 3: Runtime
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup --system nodejs && adduser --system nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
