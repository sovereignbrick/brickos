# Sovereign CRM Backend Configuration
# Copy to .env and fill in values

# Database (app-specific tables)
SCR_DATABASE_URL=postgres://brickos:password@localhost:5432/scr

# Platform database (users, orgs, billing -- read-write)
SCR_PLATFORM_DATABASE_URL=postgres://brickos:password@localhost:5432/brickos
SCR_PLATFORM_DB_POOL_MAX=5
SCR_DB_POOL_MAX=10

# Auth
SCR_JWT_SECRET=change-me-to-a-long-random-string
SCR_JWT_EXPIRY_SECS=7200
SCR_REFRESH_EXPIRY_SECS=5184000

# Server
SCR_HOST=0.0.0.0
SCR_PORT=8084

# URLs
SCR_FRONTEND_URL=http://localhost:3000
SCR_API_BASE_URL=http://localhost:8084

# Branding
SCR_PRODUCT_NAME="Sovereign CRM"
SCR_SUPPORT_EMAIL=support@brickos.io

# Encryption (AES-256-GCM, optional -- set to enable at-rest encryption)
# SCR_ENCRYPTION_KEY=64-hex-chars-here

# AI (platform-level, optional)
# BRICKOS_OLLAMA_BASE_URL=http://localhost:11434
# BRICKOS_OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=sk-ant-...

# Email (optional, omit for log-only mode)
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=mg.example.com

# Notifications (optional)
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOKEN=tk_...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# Deploy
DEPLOY_ENVIRONMENT=development
RUST_LOG=info
