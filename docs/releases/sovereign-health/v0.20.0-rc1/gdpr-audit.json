  "findings": [
    {
      "id": "GDPR-F001",
      "severity": "high",
      "article": "Art. 15/20",
      "title": "Data export missing Doctor Chat conversations",
      "description": "CSV/JSON export does not include doctor_chat_conversations and doctor_chat_messages. Required for Right of Access (Art. 15) and Data Portability (Art. 20).",
      "remediation": "Add chat conversations to export endpoint",
      "status": "open",
      "carried_from": "v1.0.0-rc2"
    },
    {
      "id": "GDPR-F002",
      "severity": "medium",
      "article": "Art. 17",
      "title": "Hard purge cron not verified",
      "description": "Soft delete works (30-day grace). Hard purge after grace period needs verification that all NO ACTION FK tables are explicitly cleaned.",
      "affected_tables": ["measurement_templates", "user_medications", "influence_factors", "user_licenses"],
      "remediation": "Implement and test hard purge cron job",
      "status": "open"
    },
    {
      "id": "GDPR-F003",
      "severity": "medium",
      "article": "Art. 32",
      "title": "Doctor Chat messages not encrypted at rest",
      "description": "doctor_chat_messages.content stores user messages in plaintext. These may contain health-related information.",
      "remediation": "Encrypt message content with AES-256-GCM (same as measurements)",
      "status": "open"
    },
    {
      "id": "GDPR-F004",
      "severity": "low",
      "article": "Art. 32",
      "title": "Contact form stores email in plaintext",
      "description": "contact_submissions stores email and name unencrypted. Low risk as this is voluntarily submitted public contact data.",
      "remediation": "Consider encrypting or auto-purging after processing",
      "status": "accepted_risk"
    },
    {
      "id": "GDPR-F005",
      "severity": "low",
      "article": "Art. 5(1)(e)",
      "title": "No automatic retention cleanup for contact_submissions",
      "description": "Contact form submissions have no expiry. Should be purged after processing (e.g., 90 days).",
      "remediation": "Add retention cron for contact_submissions",
      "status": "open"
    }
