# ${APP_TITLE} Backend Configuration
# Copy to .env and fill in values

# Database (app-specific tables)
${PREFIX_UPPER}_DATABASE_URL=postgres://brickos:password@localhost:5432/${PREFIX}

# Platform database (users, orgs, billing -- read-write)
${PREFIX_UPPER}_PLATFORM_DATABASE_URL=postgres://brickos:password@localhost:5432/brickos
${PREFIX_UPPER}_PLATFORM_DB_POOL_MAX=5
${PREFIX_UPPER}_DB_POOL_MAX=10

# Auth
${PREFIX_UPPER}_JWT_SECRET=change-me-to-a-long-random-string
${PREFIX_UPPER}_JWT_EXPIRY_SECS=7200
${PREFIX_UPPER}_REFRESH_EXPIRY_SECS=5184000

# Server
${PREFIX_UPPER}_HOST=0.0.0.0
${PREFIX_UPPER}_PORT=${PROD_PORT}

# URLs
${PREFIX_UPPER}_FRONTEND_URL=http://localhost:3000
${PREFIX_UPPER}_API_BASE_URL=http://localhost:${PROD_PORT}

# Branding
${PREFIX_UPPER}_PRODUCT_NAME="${APP_TITLE}"
${PREFIX_UPPER}_SUPPORT_EMAIL=support@brickos.io

# Encryption (AES-256-GCM, optional -- set to enable at-rest encryption)
# ${PREFIX_UPPER}_ENCRYPTION_KEY=64-hex-chars-here

# AI (platform-level, optional)
# BRICKOS_OLLAMA_BASE_URL=http://localhost:11434
# BRICKOS_OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=sk-ant-...

# Email (optional, omit for log-only mode)
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=mg.example.com

# Notifications (optional)
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOKEN=tk_...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# Deploy
DEPLOY_ENVIRONMENT=development
RUST_LOG=info
